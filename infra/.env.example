# infra/.env 로 복사해 값을 채운다. .env 는 git 에 올리지 않는다(.gitignore 등록됨).
#
# ⚠️ 이 파일의 값을 잃으면 VM 재생성 시 복구가 막힌다.
#    채운 .env 는 키체인이나 비밀번호 관리자에 따로 보관할 것.
#
# 랜덤 값 생성:  openssl rand -base64 48

# ─── Postgres (compose 가 사용) ──────────────────────────────────────────────
POSTGRES_DB=aiott
POSTGRES_USER=aiott
POSTGRES_PASSWORD=

# DB_URL / DB_USERNAME / DB_PASSWORD 는 docker-compose.yml 이 위 값으로 덮어쓴다.
# 따로 적지 않아도 된다.

# ─── 보안 (전부 필수, 기본값 없음 — 비우면 기동 실패) ─────────────────────────
# 예전에는 JWT_SECRET 에 공개된 기본값이 있어 토큰 위조가 가능했다. 반드시 새로 생성.
JWT_SECRET=
# 어드민 콘솔 로그인 (/auth/admin/login). admin/admin 기본값은 제거됐다.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 운영 지표 로그인 (/auth/ops/login)
OPS_USERNAME=
OPS_PASSWORD=

# ─── 도메인 ─────────────────────────────────────────────────────────────────
# 브라우저에서 직접 API 를 호출하는 오리진만 넣는다. 쉼표 구분.
CORS_ALLOWED_ORIGINS=https://aiott.kr,https://www.aiott.kr,https://admin.aiott.kr
# 이메일 본문의 링크(인증/비밀번호 재설정)에 쓰인다.
WEB_BASE_URL=https://aiott.kr

# ─── 스토리지 ───────────────────────────────────────────────────────────────
# r2 로 두면 HLS/썸네일이 Cloudflare R2 로 올라가고 VM 은 API 만 처리한다.
STORAGE_TYPE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-ott-media
# R2 버킷에 연결한 커스텀 도메인. r2.dev 주소는 레이트리밋이 있어 운영에 부적합하다.
R2_PUBLIC_URL=https://cdn.aiott.kr

# 트랜스코딩 임시 경로(컨테이너 내부). R2 업로드 후 정리된다.
UPLOAD_DIR=/app/data/uploads
HLS_DIR=/app/data/hls
TEMP_DIR=/app/data/tmp
FFMPEG_PATH=ffmpeg

# ─── 메일 (없으면 MAIL_ENABLED=false 로 두고 나중에 채워도 된다) ──────────────
MAIL_ENABLED=false
MAIL_FROM=noreply@aiott.kr
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Stripe (베타는 테스트 키로 충분) ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# ─── 백업 (backup.sh / restore.sh 가 사용) ──────────────────────────────────
# R2 는 S3 호환이라 aws CLI 를 그대로 쓴다. 위 R2 키를 재사용해도 된다.
BACKUP_BUCKET=ai-ott-backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

PORT=8080
